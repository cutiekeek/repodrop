# Required
DISCORD_TOKEN=
GITHUB_TOKEN=
DATABASE_URL=postgresql+asyncpg://repodrop:repodrop@localhost:5432/repodrop

# Optional
LOGFIRE_TOKEN=
ENVIRONMENT=development
# Sync slash commands to one guild for instant updates while developing
DEV_GUILD_ID=
MAX_SUBS_PER_GUILD=25
# Durations: seconds or ISO 8601 (e.g. PT5M)
POLL_MIN_INTERVAL=300
POLL_DEFAULT_INTERVAL=600
POLL_MAX_INTERVAL=3600
POLL_CONCURRENCY=8
