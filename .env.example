# Required
DISCORD_TOKEN=
GITHUB_TOKEN=
DATABASE_URL=postgresql+asyncpg://repodrop:repodrop@localhost:5432/repodrop

# Optional
LOGFIRE_TOKEN=
ENVIRONMENT=development
# Your private server: /repodrop-owner commands are registered only there
DEV_GUILD_ID=
# true = register /repodrop only in DEV_GUILD_ID (instant updates while developing)
DEV_SYNC=false
# Default per-server caps (the operator can override them per server)
MAX_REPOS_PER_GUILD=25
MAX_SUBS_PER_GUILD=100
MAX_BRANCHES_PER_SUB=5
# Discord user IDs allowed to run owner commands, comma-separated
OWNER_IDS=
# Optional link shown to blocked servers
BLOCK_CONTACT_URL=
# Durations: seconds or ISO 8601 (e.g. PT5M)
POLL_MIN_INTERVAL=300
POLL_DEFAULT_INTERVAL=600
POLL_MAX_INTERVAL=3600
POLL_CONCURRENCY=8
